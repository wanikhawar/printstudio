#!/usr/bin/python3
"""CUPS backend for the "PrintStudio" virtual printer.

CUPS runs this as root (the file is installed 0700 root). It creates the
user's spool directory, drops to that user, and saves the job as
/var/spool/printstudio/<user>/job-<id>.pdf. The printstudio-watch service
then opens the Print Studio window for it.
"""

import json
import os
import pwd
import shutil
import sys

SPOOL_ROOT = os.environ.get("PRINTSTUDIO_SPOOL_ROOT", "/var/spool/printstudio")
OK, FAILED = 0, 1  # CUPS_BACKEND_OK / CUPS_BACKEND_FAILED


def log(level, message):
    print(f"{level}: {message}", file=sys.stderr, flush=True)


def main(argv):
    if len(argv) == 1:
        # Device discovery (lpinfo -v)
        print('direct printstudio "Unknown" "Print Studio (opens your print dialog)"')
        return OK
    if len(argv) not in (6, 7):
        log("ERROR", "Usage: printstudio job-id user title copies options [file]")
        return FAILED

    job_id, user, title, copies, options = argv[1:6]
    try:
        pw = pwd.getpwnam(user)
    except KeyError:
        log("ERROR", f"Print Studio only accepts jobs from local users (got {user!r})")
        return FAILED

    as_root = os.geteuid() == 0
    if not as_root and os.geteuid() != pw.pw_uid:
        log("ERROR", "Print Studio backend must run as root (install it with mode 0700)")
        return FAILED

    user_dir = os.path.join(SPOOL_ROOT, user)
    os.makedirs(SPOOL_ROOT, mode=0o755, exist_ok=True)
    if os.path.islink(user_dir):
        log("ERROR", f"{user_dir} is a symlink, refusing to use it")
        return FAILED
    os.makedirs(user_dir, mode=0o700, exist_ok=True)
    if as_root:
        os.chown(user_dir, pw.pw_uid, pw.pw_gid)
    os.chmod(user_dir, 0o700)

    src = open(argv[6], "rb") if len(argv) == 7 else sys.stdin.buffer

    # Everything from here on runs as the user who printed.
    if as_root:
        os.setgroups([])
        os.setgid(pw.pw_gid)
        os.setuid(pw.pw_uid)
    os.umask(0o077)

    base = os.path.join(user_dir, f"job-{int(job_id)}")
    with open(base + ".json", "w") as f:
        json.dump({"title": title, "copies": copies, "options": options, "job_id": job_id}, f)
    with open(base + ".part", "wb") as f:
        shutil.copyfileobj(src, f)
    os.rename(base + ".part", base + ".pdf")  # the watcher only looks at *.pdf
    log("INFO", "Sent to Print Studio")
    return OK


if __name__ == "__main__":
    sys.exit(main(sys.argv))
